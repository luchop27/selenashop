# ==================== VARIABLES DE ENTORNO PARA PRODUCCIÓN ====================
# Copia este archivo como .env y configura tus valores reales

# Django
SECRET_KEY=tu-secret-key-super-segura-aqui
DEBUG=False
PRODUCTION=True
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Base de datos (PostgreSQL recomendado para producción)
DATABASE_URL=postgresql://usuario:password@localhost:5432/selenashop

# Email - Opción 1: SendGrid (Recomendado - 100 emails/día gratis)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=tu_api_key_de_sendgrid_aqui
DEFAULT_FROM_EMAIL=Selena Shop <noreply@tudominio.com>

# Email - Opción 2: Mailgun (12,000 emails/mes gratis)
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@tudominio.mailgun.org
# EMAIL_HOST_PASSWORD=tu_password_mailgun

# Email - Opción 3: Amazon SES (62,000 emails/mes gratis desde EC2)
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_smtp_username
# EMAIL_HOST_PASSWORD=tu_smtp_password

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_ACCESS_TOKEN=tu_access_token
WHATSAPP_ADMIN_NUMBER=593999999999

# Archivos estáticos y media (AWS S3 o similar)
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_STORAGE_BUCKET_NAME=selenashop-media
AWS_S3_REGION_NAME=us-east-1
